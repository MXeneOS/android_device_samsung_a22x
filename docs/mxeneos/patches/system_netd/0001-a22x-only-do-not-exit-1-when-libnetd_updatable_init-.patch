From 77f5d147f3955416de5e979cf68255bcad084709 Mon Sep 17 00:00:00 2001
From: Adri <git@verbto.be>
Date: Mon, 26 Oct 2026 21:15:50 +0100
Subject: [PATCH] a22x only: do not exit(1) when libnetd_updatable_init fails
 (TrebleDroid 3ab83891fb)

Change-Id: Id3ab4174c29265252f273cf9a4a80ceb76dc8913
---
 server/main.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/server/main.cpp b/server/main.cpp
index d27fd76a..e3f5fdcf 100644
--- a/server/main.cpp
+++ b/server/main.cpp
@@ -141,8 +141,8 @@ int main() {
     }
 
     if (libnetd_updatable_init(cg2_path.c_str())) {
-        ALOGE("libnetd_updatable_init failed");
-        exit(1);
+        // a22x: kernel 4.14 cannot run all of the BPF setup; keep netd running without it (TrebleDroid 3ab83891fb)
+        ALOGE("libnetd_updatable_init failed, continuing without BPF");
     }
     gLog.info("libnetd_updatable_init success");
 
-- 
2.47.3

